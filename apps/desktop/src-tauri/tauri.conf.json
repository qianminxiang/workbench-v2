{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "综合工作台",
  "version": "2.2.3",
  "identifier": "com.anhui.pr.workbench",
  "build": {
    "frontendDist": "../src",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "综合工作台 · 安徽省",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "trayIcon": {
      "iconPath": "icons/icon.png",
      "iconAsTemplate": false,
      "tooltip": "综合工作台"
    },
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi",
      "nsis"
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "resources": [],
    "shortDescription": "本地优先的综合工作台（安徽省）",
    "publisher": "安徽新标点",
    "createUpdaterArtifacts": true,
    "windows": {
      "wix": {
        "language": "zh-CN",
        "upgradeCode": "de3350cd-52fc-5f38-b777-b14d963b3722"
      },
      "nsis": {
        "languages": [
          "SimpChinese",
          "English"
        ],
        "installerHooks": "windows/installer-hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/qianminxiang/workbench-v2/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk4OTNEQUQ0MzE1Q0IwRUYKUldUdnNGd3gxTnFUbURhdzgyUDYwcCsveFFPTWpjSHhSVlp1YnNjN0NpQlBxWklLMWJyYm9jSHQK"
    }
  }
}
