{
  "$schema": "https://schema.tauri.app/capability/2",
  "identifier": "default",
  "description": "主窗口默认能力：仅放行本应用命令与通知，不给 shell 任意执行",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:default",
    "core:event:default",
    "notification:default",
    "shell:allow-open"
  ]
}
